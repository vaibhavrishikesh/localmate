# ── LocalMate environment ──────────────────────────────────────────
# Copy to .env.local and fill values. Never commit real secrets.

# Demo / staff admin API (JSON backend + optional admin verify)
LOCALMATE_ADMIN_SECRET=change-me-localmate-admin

# ── Supabase (optional — leave blank to keep demo-json backend) ────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3040

# Phone OTP: enable only with a real SMS provider in Supabase Auth.

# ── Payments (Razorpay) ────────────────────────────────────────────
# Leave blank → SIMULATED hold/release only (default, safe for demos).
# Use TEST keys first. Never put live keys in client code.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# Publishable key for Checkout.js (same as KEY_ID for Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Dashboard → Webhooks → secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Must be exactly "true" to allow rzp_live keys. Default: blocked.
PAYMENTS_LIVE=false
